    "type": "object",
    "properties": {
        "minecraft_version": {
            "type": "string",
            "description": "The Minecraft version this item list targets"
        },
        "items": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": "string"
                    },
                    "displayNameGerman": {
                        "type": "string"
                    },
                    "isBlock": {
                        "type": "boolean"
                    },
                    "renewable": {
                        "type": "string",
                        "enum": ["yes", "no", "vault_only"],
                        "$comment": "If block is renewable (infinite), some are 'vault_only', which means they are only renewable when more than 128 players open a vault, which makes them not renewable in singleplayer"
                    },
                    "stackSize": {
                        "$ref": "#/definitions/stackSizeEnum"
                    },
                    "rarityTier": {
                        "type": "string",
                        "enum": ["common", "uncommon", "rare", "epic"],
                        "default": "common"
                    },
                    "block": {
                        "type": "object",
                        "$comment": "Block-specific properties. Required when isBlock is true.",
                        "required": [
                            "hardness",
                            "blastResistance",
                            "luminousLevel",
                            "transparency",
                            "isBlockEntity",
                            "tools",
                            "flammable",
                            "catchesFire",
                            "waterloggable"
                        ],
                        "properties": {
                            "hardness": {
                                "type": "number",
                                "minimum": -1.0,
                                "maximum": 1000.0
                            },
                            "blastResistance": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 3600000.0
                            },
                            "luminousLevel": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 15
                            },
                            "transparency": {
                                "type": "string",
                                "enum": ["transparent", "partial", "opaque"]
                            },
                            "waterloggable": {
                                "type": "boolean"
                            },
                            "isBlockEntity": {
                                "type": "boolean"
                            },
                            "tools": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/toolEnum"
                                },
                                "minItems": 1
                            },
                            "flammable": {
                                "type": "boolean"
                            },
                            "catchesFire": {
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false
                    },
                    "item": {
                        "type": "object",
                        "properties": {
                            "damage": {
                                "type": "object",
                                "properties": {
                                    "attackDamage": {
                                        "type": "number",
                                        "minimum": 0.0
                                    },
                                    "attackSpeed": {
                                        "type": "number",
                                        "minimum": 0.0
                                    }
                                }
                            },
                            "armor": {
                                "type": "object",
                                "properties": {
                                    "armorPoints": {
                                        "type": "number",
                                        "minimum": 0.0
                                    },
                                    "toughness": {
                                        "type": "number",
                                        "minimum": 0.0
                                    },
                                    "knockbackResistance": {
                                        "type": "number",
                                        "minimum": 0.0
                                    }
                                }
                            },
                            "durability": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 3000
                            },
                            "enchantability": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 25
                            },
                            "possibleEnchantments": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/enchantmentEnum"
                                }
                            },
                            "fireResistant": {
                                "type": "boolean",
                                "$comment": "If this item is fire resistant (e.g. netherite)"
                            }
                        },
                        "required": ["fireResistant"]
                    },
                    "compostability": {
                        "type": "object",
                        "properties": {
                            "compostable": {
                                "type": "boolean",
                                "$comment": "If this item is compostable"
                            },
                            "chance": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1.0
                            }
                        }
                    },
                    "edible": {
                        "type": "object",
                        "properties": {
                            "hunger": {
                                "type": "number",
                                "minimum": 0.0
                            },
                            "saturation": {
                                "type": "number",
                                "minimum": 0.0
                            },
                            "alwaysConsumable": {
                                "type": "boolean"
                            }
                        }
                    },
                    "craftingIngredient": {
                        "type": "boolean",
                        "$comment": "If this item is used in any crafting recipe"
                    },
                    "isArmorTrimMaterial": {
                        "type": "boolean",
                        "$comment": "If this item is a material for armor trims"
                    },
                    "fuel": {
                        "type": "object",
                        "properties": {
                            "burnTimeSeconds": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1000.0,
                                "$comment": "Time in seconds this item burns for"
                            },
                            "numberOfItemsSmelted": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 100.0,
                                "$comment": "The number of items that can be smelted per fuel"
                            }
                        },
                        "$comment": "If this item can be used as fuel in a furnace"
                    },
                    "obtaining": {
                        "type": "object",
                        "properties": {
                            "obtainability": {
                                "type": "string",
                                "enum": ["survival", "creative_only", "unobtainable"],
                                "$comment": "survival: Standard gameplay. creative_only: Requires commands or creative menu (e.g., Command Block, Barrier). unobtainable: Technical blocks with no item form (e.g., Nether Portal block, Piston Head)."
                            },
                            "craftable": {
                                "type": "boolean",
                                "$comment": "Can be obtained by a crafting recipe"
                            },
                            "breaking": {
                                "type": "object",
                                "properties": {
                                    "requiresSilkTouch": {
                                        "type": "string",
                                        "enum": ["silk_touch_only", "yes", "no"],
                                        "$comment": "Block requires Silk Touch to drop in this form"
                                    },
                                    "requiresSpecialToolsToDrop": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/definitions/specialToolEnum"
                                        },
                                        "$comment": "Requires a specific tool at least, if not provided, it drops by hand."
                                    },
                                    "instantBreaking": {
                                        "type": "boolean"
                                    }
                                }
                            },
                            "naturalGeneration": {
                                "type": "object",
                                "properties": {
                                    "biomes": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/definitions/biomeEnum"
                                        },
                                        "minItems": 1
                                    },
                                    "dimensions": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/definitions/dimensionEnum"
                                        },
                                        "minItems": 1
                                    },
                                    "comment": {
                                        "type": "string"
                                    },
                                    "partOfStructures": {
                                        "type": "object",
                                        "properties": {
                                            "structures": {
                                                "type": "array",
                                                "items": {
                                                    "$ref": "#/definitions/structureEnum"
                                                },
                                                "minItems": 1
                                            },
                                            "comment": {
                                                "type": "string"
                                            }
                                        },
                                        "required": ["structures"]
                                    }
                                },
                                "required": ["dimensions"]
                            },
                            "generatedLoot": {
                                "type": "object",
                                "properties": {
                                    "structures": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "structure": {
                                                    "$ref": "#/definitions/structureEnum"
                                                },
                                                "chests": {
                                                    "type": "array",
                                                    "minItems": 1,
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "chestName": {
                                                                "$ref": "#/definitions/chestEnum"
                                                            },
                                                            "chance": {
                                                                "type": "number",
                                                                "minimum": 0.0,
                                                                "maximum": 1.0
                                                            },
                                                            "quantity": { "$ref": "#/definitions/quantitySpec" }
                                                        },
                                                        "required": ["chestName", "chance"],
                                                        "additionalProperties": false
                                                    }
                                                },
                                                "comment": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": ["structure", "chests"],
                                            "additionalProperties": false
                                        }
                                    }
                                }
                            },
                            "mobLoot": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "mob": {
                                            "$ref": "#/definitions/mobEnum"
                                        },
                                        "chance": {
                                            "type": "number",
                                            "minimum": 0.0,
                                            "maximum": 1.0
                                        },
                                        "quantity": { "$ref": "#/definitions/quantitySpec" },
                                        "comment": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "trading": {
                                "type": "object",
                                "properties": {
                                    "villagers": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "profession": {
                                                    "$ref": "#/definitions/villagerProfessionEnum"
                                                },
                                                "level": {
                                                    "type": "string",
                                                    "enum": [
                                                        "Novice (1)",
                                                        "Apprentice (2)",
                                                        "Journeyman (3)",
                                                        "Expert (4)",
                                                        "Master (5)"
                                                    ]
                                                },
                                                "probability": {
                                                    "type": "number",
                                                    "minimum": 0.0,
                                                    "maximum": 1.0
                                                },
                                                "quantity": { "$ref": "#/definitions/quantitySpec" },
                                                "comment": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": ["profession", "level", "probability"]
                                        },
                                        "wanderingTrader": {
                                            "type": "object",
                                            "properties": {
                                                "chance": {
                                                    "type": "number",
                                                    "minimum": 0.0,
                                                    "maximum": 1.0
                                                },
                                                "quantity": { "$ref": "#/definitions/quantitySpec" },
                                                "comment": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": ["chance"]
                                        }
                                    }
                                },
                                "anyOf": [{ "required": ["villagers"] }, { "required": ["wanderingTrader"] }]
                            },
                            "fishing": {
                                "type": "object",
                                "properties": {
                                    "category": {
                                        "type": "string",
                                        "enum": ["fish", "treasure", "junk"]
                                    },
                                    "chance": {
                                        "type": "number",
                                        "minimum": 0.0,
                                        "maximum": 1.0
                                    },
                                    "quantity": { "$ref": "#/definitions/quantitySpec" },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": ["category", "chance"]
                            },
                            "bartering": {
                                "type": "object",
                                "properties": {
                                    "chance": {
                                        "type": "number",
                                        "minimum": 0.0,
                                        "maximum": 1.0
                                    },
                                    "quantity": { "$ref": "#/definitions/quantitySpec" },
                                    "comment": {
                                        "type": "string"
                                    }
                                },
                                "required": ["chance"]
                            },
                            "smelting": {
                                "type": "object",
                                "properties": {
                                    "smeltable": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "string",
                                            "enum": ["furnace", "blast_furnace", "smoker", "campfire"]
                                        }
                                    },
                                    "xpFromSmelting": {
                                        "type": "number",
                                        "minimum": 0.1
                                    }
                                },
                                "required": ["smeltable", "xpFromSmelting"]
                            },
                            "difficultyToObtain": {
                                "type": "integer",
                                "minimum": -1,
                                "maximum": 10
                            }
                        },
                        "required": ["obtainability", "difficultyToObtain"]
                    }
                },
                "required": ["displayName", "displayNameGerman", "isBlock", "renewable", "rarityTier", "obtaining"],
                "oneOf": [
                    {
                        "$comment": "Block item — isBlock must be true and block sub-object must be present. Item-only fields (damage, durability, possibleEnchantments) are forbidden.",
                        "properties": {
                            "isBlock": { "const": true },
                            "item": false
                        },
                        "required": ["block"]
                    },
                    {
                        "$comment": "Non-block item — isBlock must be false and block sub-object must not be present.",
                        "properties": {
                            "isBlock": { "const": false },
                            "block": false
                        },
                        "required": ["item"]
                    }
                ]
            }
        }
    }
}
