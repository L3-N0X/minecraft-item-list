    "type": "object",
    "additionalProperties": {
        "type": "object",
        "properties": {
            "displayName": {
                "type": "string"
            },
            "displayNameGerman": {
                "type": "string"
            },
            "isBlock": {
                "type": "boolean"
            },
            "stackSize": {
                "$ref": "#/definitions/stackSizeEnum"
            },
            "renewable": {
                "type": "boolean"
            },
            "survivalObtainable": {
                "type": "boolean"
            },
            "dealsDamage": {
                "type": "boolean"
            },
            "difficultyToObtain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
            },
            "enchantments": {
                "enchantments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/enchantmentEnum"
                    }
                }
            },
            "edible": {
                "type": "boolean"
            },
            "flammable": {
                "type": "boolean"
            },
            "craftable": {
                "type": "boolean"
            },
            "blastResistance": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 3600000.0
            },
            "hardness": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1000.0
            },
            "tool": {
                "$ref": "#/definitions/toolEnum"
            },
            "obtaining": {
                "type": "object",
                "properties": {
                    "naturalGeneration": {
                        "type": "object",
                        "properties": {
                            "biomes": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/biomeEnum"
                                }
                            },
                            "dimensions": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/dimensionEnum"
                                }
                            },
                            "structures": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/structureEnum"
                                }
                            }
                        },
                        "required": ["biomes", "structures", "dimensions"]
                    },
                    "loot": {
                        "type": "object",
                        "properties": {
                            "structures": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/structureEnum"
                                }
                            },
                            "mobs": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/mobEnum"
                                }
                            }
                        },
                        "required": ["structures", "mobs"]
                    },
                    "trading": {
                        "type": "object",
                        "properties": {
                            "villager": {
                                "type": "object",
                                "properties": {
                                    "profession": {
                                        "$ref": "#/definitions/villagerProfessionEnum"
                                    },
                                    "level": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 5
                                    }
                                },
                                "required": ["profession", "level"]
                            },
                            "wanderingTrader": {
                                "type": "boolean"
                            }
                        },
                        "required": ["villager", "wanderingTrader"]
                    }
                },
                "required": ["structures", "dimensions"]
            }
        },
        "required": ["displayName"]
    }
}
